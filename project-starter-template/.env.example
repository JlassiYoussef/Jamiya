# Copy this file to `.env` and fill in real values. NEVER commit your real .env.
# `.env` is gitignored; `.env.example` is committed so teammates know what's needed.
#
#   cp .env.example .env
#
# List every environment variable the project needs, with a safe placeholder.

# Example:
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# API_KEY=your-api-key-here
# PORT=3000
